# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key (server-side only). Bypasses RLS - never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: allows POST /register to create 'admin' / 'staff' accounts when the
# X-Bootstrap-Token header matches. Leave blank to restrict registration to
# 'customer' only.
BOOTSTRAP_TOKEN=

# Signs this API's access tokens. Must be at least 32 characters.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=brightloop-api
ACCESS_TOKEN_EXPIRE_MINUTES=60
